#
# openDesk Edu fork — extended with OpenCloud, SOGo, and ILIAS support.
#
# Copy this file to .env or .env.prod and adjust values for your environment.

# === Intercom Service ===
BASE_URL=https://ics.opendesk.hrz.uni-marburg.de
PORT=8008
LOG_LEVEL=DEBUG
ORIGIN_REGEX=opendesk\.hrz\.uni-marburg\.de
SECRET=change-me-to-a-random-secret
PROXY=false

# === OIDC / Keycloak ===
ISSUER_BASE_URL=https://id.opendesk.hrz.uni-marburg.de/realms/opendesk
CLIENT_ID=opendesk-intercom
CLIENT_SECRET=change-me
KEYCLOAK_URL=https://id.opendesk.hrz.uni-marburg.de
REALM_NAME=opendesk

# === Session ===
ENABLE_SESSION_COOKIE=true
SESSION_ROLLING_DURATION=86400

# === Claims ===
USER_UNIQUE_MAPPER=opendesk_username
USERNAME_CLAIM=opendesk_username

# === Redis ===
REDIS_HOST=redis-headless
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_USER=default
REDIS_SSL=false
REDIS_MTLS=false

# === Portal ===
PORTAL_URL=https://portal.opendesk.hrz.uni-marburg.de
PORTAL_API_KEY=change-me

# === Matrix ===
MATRIX_ENABLED=true
MATRIX_URL=https://matrix.opendesk.hrz.uni-marburg.de
MATRIX_SERVER_NAME=matrix.opendesk.hrz.uni-marburg.de
MATRIX_AS_SECRET=change-me

# === Nordeck ===
NORDECK_MODE=test
NORDECK_URL=https://matrix-neodatefix-bot.opendesk.hrz.uni-marburg.de

# === XWiki ===
XWIKI_ENABLED=true
XWIKI_URL=https://wiki.opendesk.hrz.uni-marburg.de
XWIKI_AUDIENCE=opendesk-xwiki

# === Nextcloud (legacy - upstream compatibility) ===
NC_ENABLED=false
NC_URL=https://files.opendesk.hrz.uni-marburg.de
NC_AUDIENCE=opendesk-nextcloud

# === OpenCloud (openDesk Edu primary file service) ===
OC_ENABLED=true
OC_URL=https://opencloud.opendesk.hrz.uni-marburg.de
OC_AUDIENCE=opendesk-opencloud

# === SOGo Groupware (CalDAV, CardDAV) ===
SOGO_ENABLED=true
SOGO_URL=https://sogo.opendesk.hrz.uni-marburg.de
SOGO_AUDIENCE=opendesk-sogo

# === ILIAS LMS ===
ILIAS_ENABLED=true
ILIAS_URL=https://lms.opendesk.hrz.uni-marburg.de
ILIAS_AUDIENCE=opendesk-ilias
